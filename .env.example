# Copy to .env for local development. On Railway these are set as
# service variables instead (Variables tab).

# Postgres. On Railway: DATABASE_URL = ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sakerhetskontroll

# Password for /admin. Username defaults to "admin".
ADMIN_PASSWORD=byt-mig
# ADMIN_USER=admin

# Leave PUBLIC_BASE_URL unset unless you have your own domain. Unset, the
# QR codes use the address the /qr page was opened on, which is always the
# right one. If you do set it, set it to YOUR address -- a wrong value
# prints QR codes that lead nowhere. /qr warns when the two disagree.
# PUBLIC_BASE_URL=https://<din-egna-doman>

# PORT is provided by Railway; locally it defaults to 3000.
# PORT=3000

# Sallsynt: styr TLS mot databasen manuellt.
# ?sslmode=disable eller ?sslmode=require i DATABASE_URL styr laget;
# DB_SSL_STRICT=1 kraver dessutom ett verifierbart certifikat.
# DB_CONNECT_ATTEMPTS=6   # antal forsok innan appen ger upp
