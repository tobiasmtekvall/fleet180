# Copy to .env for local development. On Railway these are set as
# service variables instead (Variables tab).

# --- Databas ---------------------------------------------------------
# På Railway: DATABASE_URL = ${{Postgres.DATABASE_URL}}  (via "Add Reference")
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sakerhetskontroll

# --- Administration --------------------------------------------------
# Lösenord för /admin. Användarnamnet är "admin" om inget annat anges.
ADMIN_PASSWORD=byt-mig
# ADMIN_USER=admin

# --- API -------------------------------------------------------------
# En delad nyckel för /api/*: förarsynken postar med den, och Chrome-
# tillägget hämtar med den. Utan den är API:t helt avstängt.
# Ta något långt och slumpmässigt, t.ex. `openssl rand -hex 24`.
API_TOKEN=

# --- Dagsmejl --------------------------------------------------------
# Nyckel från resend.com. Utan den skickas inget mejl; sammanfattningen
# går ändå att läsa på /admin/daily-summary.
RESEND_API_KEY=
SUMMARY_TO=tobias.ekvall@instabee.com
# Timme (0-23) i svensk tid då mejlet skickas. Standard 17.
# SUMMARY_HOUR=17
# Avsändare. onboarding@resend.dev fungerar direkt men kan bara leverera
# till kontots egen adress – byt när du verifierat en egen domän.
# MAIL_FROM=Fleet 180 <fleet180@dindoman.se>

# --- Adress ----------------------------------------------------------
# Lämna PUBLIC_BASE_URL osatt om du inte har en egen domän: QR-koderna
# byggs då av adressen /qr öppnades på, vilket alltid är rätt.
# PUBLIC_BASE_URL=https://<din-egna-doman>

# PORT sätts av Railway; lokalt är den 3000.
# PORT=3000

# Sällsynt: styr TLS mot databasen manuellt.
# ?sslmode=disable eller ?sslmode=require i DATABASE_URL styr läget;
# DB_SSL_STRICT=1 kräver dessutom ett verifierbart certifikat.
# DB_CONNECT_ATTEMPTS=6   # antal försök innan appen ger upp
