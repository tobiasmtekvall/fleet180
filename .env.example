# Copy to .env for local development. On Railway these are set as
# service variables instead (Variables tab).

# Postgres. On Railway: DATABASE_URL = ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sakerhetskontroll

# Password for /admin. Username defaults to "admin".
ADMIN_PASSWORD=byt-mig
# ADMIN_USER=admin

# Optional: the public address the QR codes should encode. If unset the
# app uses Railway's RAILWAY_PUBLIC_DOMAIN, then the request host.
# PUBLIC_BASE_URL=https://sakerhetskontroll.up.railway.app

# PORT is provided by Railway; locally it defaults to 3000.
# PORT=3000
